---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { faqComponentItems } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = faqComponentItems[lang];
---

<section id="faq" class="bg-slate-50 px-6 py-20 dark:bg-slate-900/50 lg:py-28">
  <div class="mx-auto max-w-3xl">
    <div class="mb-12 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-garden-600 dark:text-garden-400">
        {t("faqComp.eyebrow")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("faqComp.title")}
      </h2>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-5 transition open:ring-2 open:ring-garden-500/20 dark:border-slate-700 dark:bg-slate-900">
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-slate-900 dark:text-white">
              {faq.question}
              <span class="ml-4 shrink-0 text-garden-600 transition group-open:rotate-180 dark:text-garden-400">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={lang === "en" ? "/en/faq" : "/faq"}
        class="inline-flex items-center font-medium text-garden-600 hover:text-garden-700 dark:text-garden-400 dark:hover:text-garden-300"
      >
        {t("faqComp.viewAll")}
        <svg class="ml-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
