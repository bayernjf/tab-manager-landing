---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
  tags?: string[];
}

const { icon, title, description, tags = [] } = Astro.props;
---

<div class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-garden-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900 dark:hover:border-garden-700 sm:p-8">
  <div class="mb-4 inline-flex w-fit rounded-xl bg-garden-100 p-3 text-garden-700 transition group-hover:bg-garden-600 group-hover:text-white dark:bg-garden-900/40 dark:text-garden-300 dark:group-hover:bg-garden-600 dark:group-hover:text-white">
    <Icon name={icon} size={24} />
  </div>
  <h3 class="mb-3 text-xl font-semibold text-slate-900 dark:text-white">{title}</h3>
  <p class="leading-relaxed text-slate-600 dark:text-slate-300">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 font-mono text-[11px] uppercase tracking-wider text-slate-400 dark:text-slate-500">
        {tags.map((t) => (
          <li class="before:mr-1.5 before:text-garden-500 before:content-['·']">{t}</li>
        ))}
      </ul>
    )
  }
</div>
