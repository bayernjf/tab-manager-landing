---
import FeatureCard from "./FeatureCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { IconName } from "../types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features: { icon: IconName; title: string; description: string; tags: string[] }[] = [
  {
    icon: "layers",
    title: t("features.f1.title"),
    description: t("features.f1.desc"),
    tags: [t("features.f1.tag1"), t("features.f1.tag2"), t("features.f1.tag3")],
  },
  {
    icon: "monitor",
    title: t("features.f2.title"),
    description: t("features.f2.desc"),
    tags: [t("features.f2.tag1"), t("features.f2.tag2"), t("features.f2.tag3")],
  },
  {
    icon: "mouse-pointer",
    title: t("features.f3.title"),
    description: t("features.f3.desc"),
    tags: [t("features.f3.tag1"), t("features.f3.tag2"), t("features.f3.tag3")],
  },
  {
    icon: "bookmark",
    title: t("features.f4.title"),
    description: t("features.f4.desc"),
    tags: [t("features.f4.tag1"), t("features.f4.tag2")],
  },
  {
    icon: "briefcase",
    title: t("features.f5.title"),
    description: t("features.f5.desc"),
    tags: [t("features.f5.tag1"), t("features.f5.tag2")],
  },
  {
    icon: "copy-x",
    title: t("features.f6.title"),
    description: t("features.f6.desc"),
    tags: [t("features.f6.tag1"), t("features.f6.tag2")],
  },
];
---

<section id="features" class="px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold text-garden-600 dark:text-garden-400">
        {t("features.eyebrow")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("features.title")}
      </h2>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        {t("features.subtitle")}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard
          icon={f.icon}
          title={f.title}
          description={f.description}
          tags={f.tags}
        />
      ))}
    </div>
  </div>
</section>
