---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const cols = [
  {
    title: t("footer.product"),
    links: [
      { label: t("nav.features"), href: "#features" },
      { label: t("nav.why"), href: "#why" },
      { label: t("nav.how"), href: "#how" },
      { label: t("footer.changelog"), href: getLocalizedPath("/changelog", lang) },
    ],
  },
  {
    title: t("footer.resources"),
    links: [
      { label: t("nav.faq"), href: getLocalizedPath("/faq", lang) },
      { label: t("footer.privacy"), href: getLocalizedPath("/privacy", lang) },
      { label: t("footer.terms"), href: getLocalizedPath("/terms", lang) },
      { label: t("footer.joinBeta"), href: "#beta" },
      { label: "BayJF", href: "https://bayjf.com" },
      { label: "GitHub", href: "https://github.com/bayernjf/tab-manager" },
    ],
  },
];
---

<footer class="border-t border-slate-200 bg-white px-6 py-12 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#10b981" />
            <rect x="9" y="12" width="14" height="10" rx="2" fill="white" opacity="0.35" />
            <path d="M9 12 L11 8 H15 L17 12" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.35" />
            <rect x="11" y="13" width="14" height="10" rx="2" fill="white" opacity="0.65" />
            <path d="M11 13 L13 9 H17 L19 13" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.65" />
            <rect x="13" y="14" width="14" height="10" rx="2" fill="white" />
            <path d="M13 14 L15 10 H19 L21 14" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-lg font-semibold text-slate-900 dark:text-white">Tab Garden</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          {t("footer.tagline")}
        </p>
        <p class="mt-4 text-xs text-slate-400 dark:text-slate-500">
          {t("footer.supports")}
        </p>
      </div>

      {cols.map((col) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{col.title}</h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                {l.href === "https://bayjf.com" ? (
                  <BayjfLink size={16} class="text-sm text-slate-600 transition-colors hover:text-garden-600 dark:text-slate-300 dark:hover:text-garden-400" label={l.label} />
                ) : l.href === "https://github.com/bayernjf/tab-manager" ? (
                  <StarOnGithub href="https://github.com/bayernjf/tab-manager" size={14} class="text-slate-600 dark:text-slate-300" />
                ) : (
                  <a href={l.href} class="text-sm text-slate-600 transition-colors hover:text-garden-600 dark:text-slate-300 dark:hover:text-garden-400">
                    {l.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-100 pt-6 dark:border-slate-800 sm:flex-row">
      <p class="text-xs text-slate-500 dark:text-slate-500">
        {t("footer.copyright").replace("{year}", String(year))}
      </p>
      <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400 dark:text-slate-600">
        {t("footer.builtWith")}
      </p>
    </div>
  </div>
</footer>
