---
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { IconName } from "../types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps: { icon: IconName; title: string; body: string }[] = [
  { icon: "layout-grid", title: t("how.step1.title"), body: t("how.step1.body") },
  { icon: "layers", title: t("how.step2.title"), body: t("how.step2.body") },
  { icon: "bookmark", title: t("how.step3.title"), body: t("how.step3.body") },
  { icon: "cloud-sync", title: t("how.step4.title"), body: t("how.step4.body") },
];
---

<section id="how" class="bg-slate-50 px-6 py-20 dark:bg-slate-900/40 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-garden-600 dark:text-garden-400">
        {t("how.eyebrow")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("how.title")}
      </h2>
    </div>

    <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <span class="absolute right-5 top-5 font-mono text-2xl font-bold text-slate-100 dark:text-slate-800">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="mb-4 inline-flex rounded-xl bg-garden-100 p-3 text-garden-700 dark:bg-garden-900/40 dark:text-garden-300">
            <Icon name={s.icon} size={22} />
          </div>
          <h3 class="mb-2 text-base font-semibold text-slate-900 dark:text-white">{s.title}</h3>
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
