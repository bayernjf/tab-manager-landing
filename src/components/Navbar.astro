---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations, getAltLangPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: "#features", label: t("nav.features") },
  { href: "#why", label: t("nav.why") },
  { href: "#how", label: t("nav.how") },
  { href: "#privacy", label: t("nav.privacy") },
  { href: "#faq", label: t("nav.faq") },
];

const { lang: altLang, path: altPath } = getAltLangPath(Astro.url.pathname, lang);
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent bg-white/80 backdrop-blur-md transition-colors dark:bg-slate-950/80"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2" aria-label={t("nav.homeAria")}>
      <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#10b981" />
        <rect x="9" y="12" width="14" height="10" rx="2" fill="white" opacity="0.35" />
        <path d="M9 12 L11 8 H15 L17 12" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.35" />
        <rect x="11" y="13" width="14" height="10" rx="2" fill="white" opacity="0.65" />
        <path d="M11 13 L13 9 H17 L19 13" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.65" />
        <rect x="13" y="14" width="14" height="10" rx="2" fill="white" />
        <path d="M13 14 L15 10 H19 L21 14" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="text-base font-semibold text-slate-900 dark:text-white">Tab Garden</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-sm font-medium text-slate-600 transition-colors hover:text-garden-600 dark:text-slate-300 dark:hover:text-garden-400"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <BayjfLink size={18} class="hidden text-sm font-medium text-slate-600 transition-colors hover:text-garden-600 dark:text-slate-300 dark:hover:text-garden-400 sm:inline-block" />
      <StarOnGithub href="https://github.com/bayernjf/tab-manager" size={15} class="hidden text-slate-600 dark:text-slate-300 sm:inline-flex" />
      <a
        href={altPath}
        class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
        lang={altLang === "en" ? "en" : "zh"}
      >
        {altLang === "en" ? "EN" : "中文"}
      </a>
      <a
        href="#beta"
        class="hidden rounded-lg bg-garden-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-garden-700 sm:inline-flex"
      >
        {t("nav.joinBeta")}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 md:hidden"
        aria-label={t("nav.toggleMenu")}
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <div id="nav-mobile" class="hidden border-t border-slate-100 bg-white px-6 py-3 dark:border-slate-800 dark:bg-slate-950 md:hidden">
    <ul class="flex flex-col gap-1">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-garden-600 dark:text-slate-200 dark:hover:bg-slate-800"
            data-nav-close
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <BayjfLink size={18} class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-garden-600 dark:text-slate-200 dark:hover:bg-slate-800" data-nav-close />
      </li>
      <li class="px-3 py-2">
        <StarOnGithub href="https://github.com/bayernjf/tab-manager" size={15} class="text-slate-700 dark:text-slate-200" data-nav-close />
      </li>
      <li class="flex items-center gap-2 px-3 py-2">
        <a
          href={altPath}
          class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:text-slate-300"
          lang={altLang === "en" ? "en" : "zh"}
        >
          {altLang === "en" ? "EN" : "中文"}
        </a>
      </li>
      <li>
        <a
          href="#beta"
          class="mt-1 block rounded-lg bg-garden-600 px-3 py-2 text-center text-sm font-semibold text-white"
          data-nav-close
        >
          {t("nav.joinBeta")}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobile = document.getElementById("nav-mobile");
  const closeEls = document.querySelectorAll("[data-nav-close]");

  function setOpen(open: boolean) {
    mobile?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  }

  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.contains("hidden");
    setOpen(!!open);
  });
  closeEls.forEach((el) => el.addEventListener("click", () => setOpen(false)));

  const header = document.getElementById("site-nav");
  // Nav border toggle via a top sentinel + IntersectionObserver
  // (no window scroll listener)
  const navSentinel = document.createElement("div");
  navSentinel.setAttribute("aria-hidden", "true");
  navSentinel.style.cssText = "position:absolute;top:8px;height:1px;width:1px;pointer-events:none;";
  document.body.prepend(navSentinel);
  new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      header?.classList.remove("border-slate-200", "dark:border-slate-800");
    } else {
      header?.classList.add("border-slate-200", "dark:border-slate-800");
    }
  }).observe(navSentinel);
</script>
