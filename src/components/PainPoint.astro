---
import Icon from "./Icon.astro";

const steps = [
  { num: "01", title: "打开看板", body: "全屏看板聚合所有窗口标签，自动按域名归组" },
  { num: "02", title: "定位分组", body: "按窗口过滤或搜索标题/URL/域名，3 秒锁定" },
  { num: "03", title: "点击直达", body: "点击卡片即跳转到对应窗口并激活该标签" },
];
---

<section class="px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-garden-600 dark:text-garden-400">
          痛点
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          找那个标签，不该花 5 分钟
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          我们都经历过：明知某个标签开着，却在 50 个拥挤的标题里翻来翻去。Tab Garden 的全屏看板让定位缩短到 3 秒。
        </p>

        <ol class="mt-8 space-y-5">
          {steps.map((s) => (
            <li class="flex items-start gap-4">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-garden-100 font-mono text-sm font-bold text-garden-700 dark:bg-garden-900/40 dark:text-garden-300">
                {s.num}
              </span>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-white">{s.title}</h3>
                <p class="text-sm text-slate-600 dark:text-slate-300">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8">
        <div class="space-y-4">
          <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800/60">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-slate-500 dark:text-slate-400">以前</span>
              <span class="font-mono text-sm font-bold text-red-500">~5 分钟</span>
            </div>
            <div class="mt-2 h-2 w-full rounded-full bg-slate-200 dark:bg-slate-700">
              <div class="h-2 rounded-full bg-red-400" style="width: 95%"></div>
            </div>
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">在 50+ 标签里线性扫描、反复切换</p>
          </div>

          <div class="rounded-xl bg-garden-50 p-4 dark:bg-garden-950/30">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-garden-700 dark:text-garden-300">用 Tab Garden</span>
              <span class="font-mono text-sm font-bold text-garden-600 dark:text-garden-400">~3 秒</span>
            </div>
            <div class="mt-2 h-2 w-full rounded-full bg-garden-100 dark:bg-garden-900/40">
              <div class="h-2 rounded-full bg-garden-500" style="width: 8%"></div>
            </div>
            <p class="mt-2 text-xs text-garden-700/80 dark:text-garden-300/70">打开看板 → 进入对应分组 → 找到标签</p>
          </div>

          <div class="grid grid-cols-3 gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
            <div class="text-center">
              <div class="font-mono text-xl font-bold text-slate-900 dark:text-white">3</div>
              <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">桌面瀑布流通道</div>
            </div>
            <div class="text-center">
              <div class="font-mono text-xl font-bold text-slate-900 dark:text-white">9</div>
              <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">分组颜色</div>
            </div>
            <div class="text-center">
              <div class="font-mono text-xl font-bold text-slate-900 dark:text-white">300ms</div>
              <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">看板刷新节流</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
