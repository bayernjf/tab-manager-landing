---
import Icon from "./Icon.astro";

const points = [
  {
    icon: "lock",
    title: "本地优先",
    body: "所有分组、布局、稍后处理项、自定义组默认只存在 chrome.storage.local，不经过任何服务器。",
  },
  {
    icon: "ban",
    title: "不自动上传标签",
    body: "扩展绝不自动或实时上传你当前打开的标签页。工作区同步的是你手动挑选并命名的标题+URL 集合，运行时 ID 全部剥离。",
  },
  {
    icon: "key",
    title: "RLS 行级隔离",
    body: "同步走你自己的 Supabase，每张表用 auth.uid() = user_id 隔离。service_role 密钥永不进入扩展，只有 anon key 在构建里。",
  },
  {
    icon: "download",
    title: "全量导出，零锁定",
    body: "设置、域名规则、忽略网站一键导出 JSON，导入前预览数量并明确确认才覆盖。不绑定任何账号体系。",
  },
];

const permissions = ["tabs", "storage", "host: *.supabase.co (可选)"];
---

<section id="privacy" class="px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-garden-600 dark:text-garden-400">
          隐私与数据
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          你的数据，归你所有
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          Tab Garden 不在服务器上囤积你的浏览记录。本地优先存储 + 可自托管 Supabase 同步，权限只申请「tabs」「storage」与可选的 Supabase 主机权限。
        </p>

        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/60">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            扩展申请的全部权限
          </p>
          <div class="flex flex-wrap gap-2">
            {permissions.map((p) => (
              <span class="rounded-md bg-garden-50 px-2.5 py-1 font-mono text-xs text-garden-700 dark:bg-garden-900/30 dark:text-garden-300">
                {p}
              </span>
            ))}
          </div>
          <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            不申请 tabGroups、history、bookmarks、cookies 等任何敏感权限。
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {points.map((p) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-garden-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-garden-700">
            <span class="mb-3 inline-flex rounded-lg bg-garden-100 p-2 text-garden-700 dark:bg-garden-900/40 dark:text-garden-300">
              <Icon name={p.icon} size={18} />
            </span>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{p.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
