---
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { IconName } from "../types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const usps: { icon: IconName; title: string; body: string }[] = [
  { icon: "ban", title: t("why.usp1.title"), body: t("why.usp1.body") },
  { icon: "zap", title: t("why.usp2.title"), body: t("why.usp2.body") },
  { icon: "key", title: t("why.usp3.title"), body: t("why.usp3.body") },
  { icon: "download", title: t("why.usp4.title"), body: t("why.usp4.body") },
];

const compared = [
  t("why.cmp1"),
  t("why.cmp2"),
  t("why.cmp3"),
  t("why.cmp4"),
  t("why.cmp5"),
  t("why.cmp6"),
  t("why.cmp7"),
];
---

<section id="why" class="bg-slate-900 px-6 py-20 text-white dark:bg-slate-950 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-garden-400">
        {t("why.eyebrow")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {t("why.title")}
      </h2>
      <p class="mt-4 text-lg text-slate-300">
        {t("why.subtitle")}
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="grid gap-5 sm:grid-cols-2">
        {usps.map((u) => (
          <div class="rounded-2xl bg-slate-800/50 p-6 ring-1 ring-slate-700 backdrop-blur">
            <div class="mb-3 inline-flex rounded-xl bg-garden-500/20 p-2.5 text-garden-300">
              <Icon name={u.icon} size={22} />
            </div>
            <h3 class="mb-2 text-base font-semibold text-white">{u.title}</h3>
            <p class="text-sm leading-relaxed text-slate-300">{u.body}</p>
          </div>
        ))}
      </div>

      <div class="rounded-2xl bg-slate-800/50 p-6 ring-1 ring-slate-700 backdrop-blur sm:p-8">
        <h3 class="mb-5 text-lg font-semibold text-white">{t("why.canDo")}</h3>
        <ul class="space-y-3">
          {compared.map((c) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-garden-500/20 text-garden-300">
                <Icon name="check" size={14} />
              </span>
              <span class="text-sm text-slate-200">{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
