---
import "../styles/global.css";
import { getLangFromUrl, useTranslations, type Lang } from "../i18n/utils";
import { faqComponentItems } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("layout.defaultTitle"),
  description = t("layout.defaultDescription"),
  ogImage = "/og-image.jpg",
} = Astro.props;

const SITE = "https://tabgarden.pages.dev";

// Localized canonical: use the current pathname.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = `${SITE}${pathname}`;

// Localized paths for hreflang.
const zhPath = lang === "en" ? pathname.replace(/^\/en(?:\/|$)/, "/") : pathname;
const enPath = lang === "en" ? pathname : `/en${pathname === "/" ? "" : pathname}`;

const htmlLang = lang === "en" ? "en-US" : "zh-CN";
const ogLocale = lang === "en" ? "en_US" : "zh_CN";

const faqItems = faqComponentItems[lang];

const softwareAppDesc = t("layout.softwareAppDesc");

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Tab Garden",
  url: SITE,
  description: t("layout.defaultDescription"),
  inLanguage: htmlLang,
};

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
  url: `${SITE}${pathname}`,
  inLanguage: htmlLang,
  isPartOf: {
    "@type": "WebSite",
    name: "Tab Garden",
    url: SITE,
  },
};

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tab Garden",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Chrome, Edge",
  description: softwareAppDesc,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const faqPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10b981" />
    <meta name="author" content="Tab Garden" />

    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=7" />

    {/* hreflang */}
    <link rel="alternate" hreflang="zh-CN" href={`${SITE}${zhPath}`} />
    <link rel="alternate" hreflang="en-US" href={`${SITE}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}${zhPath}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}${ogImage}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Tab Garden" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}${ogImage}`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareAppJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPageJsonLd)} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <slot />
  </body>
</html>
