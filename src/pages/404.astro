---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const zh = lang === "zh";
---

<Layout title={zh ? "404 — 页面不存在" : "404 — Page Not Found"} description={zh ? "你访问的页面不存在或已被移动。" : "The page you visited does not exist or has been moved."} lang={lang}>
  <Navbar />
  <main class="px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">404</p>
      <h1 class="mb-3 mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {zh ? "页面不存在" : "Page Not Found"}
      </h1>
      <p class="text-slate-600 dark:text-slate-400">
        {zh ? "你访问的页面不存在，或者已经被移动。" : "The page you visited does not exist or has been moved."}
      </p>
      <a
        href={zh ? "/" : "/en"}
        class="mt-8 inline-flex items-center justify-center rounded-full bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-emerald-500"
      >
        {zh ? "回到首页" : "Back to Home"}
      </a>
    </div>
  </main>
  <Footer />
</Layout>
