---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { changelogReleases } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const releases = changelogReleases[lang];
---

<Layout title={t("changelogPage.title")} description={t("changelogPage.description")} lang={lang}>
  <Navbar />
  <main class="px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-12 text-center text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("changelogPage.h1")}
      </h1>

      <div class="relative space-y-8 border-l-2 border-slate-200 pl-8 dark:border-slate-800">
        {
          releases.map((release) => (
            <div class="relative">
              <span class="absolute -left-[41px] top-1.5 h-5 w-5 rounded-full border-4 border-white bg-garden-500 dark:border-slate-950 dark:bg-garden-400"></span>
              <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
                <div class="mb-2 flex flex-wrap items-center gap-3">
                  <span class="rounded-lg bg-garden-100 px-2.5 py-1 text-sm font-semibold text-garden-800 dark:bg-garden-900/40 dark:text-garden-300">
                    {release.version}
                  </span>
                  <time class="text-sm text-slate-500 dark:text-slate-400">{release.date}</time>
                </div>
                <h2 class="mb-3 text-xl font-semibold text-slate-900 dark:text-white">{release.title}</h2>
                <ul class="list-disc space-y-1.5 pl-5 text-slate-600 dark:text-slate-300">
                  {release.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>
