---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { faqPageItems } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const faqs = faqPageItems[lang];
---

<Layout title={t("faqPage.title")} description={t("faqPage.description")} lang={lang}>
  <Navbar />
  <main class="px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-3 text-center text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("faqPage.h1")}
      </h1>
      <p class="mb-12 text-center text-slate-600 dark:text-slate-300">
        {t("faqPage.subtitle")}
      </p>

      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-2xl border border-slate-200 bg-white p-5 open:ring-2 open:ring-garden-500/20 dark:border-slate-700 dark:bg-slate-900">
              <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-slate-900 dark:text-white">
                {faq.question}
                <span class="ml-4 shrink-0 text-garden-600 transition group-open:rotate-180 dark:text-garden-400">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{faq.answer}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-12 rounded-2xl bg-garden-50 p-6 text-center dark:bg-garden-950/20">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{t("faqPage.moreTitle")}</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">{t("faqPage.moreBody")}</p>
        <a
          href="/#beta"
          class="mt-4 inline-flex items-center rounded-xl bg-garden-600 px-5 py-2.5 font-semibold text-white transition hover:bg-garden-700"
        >
          {t("faqPage.backToHome")}
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
