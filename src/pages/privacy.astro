---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [1, 2, 3, 4, 5, 6, 7, 8].map((i) => ({
  title: t(`privacyPage.s${i}.title`),
  body: t(`privacyPage.s${i}.body`),
}));
---

<Layout title={t("privacyPage.title")} description={t("privacyPage.description")} lang={lang}>
  <Navbar />
  <main class="px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-3 text-center text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {t("privacyPage.h1")}
      </h1>
      <p class="mb-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {t("privacyPage.updated")}
      </p>
      <p class="mb-12 text-center text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {t("privacyPage.intro")}
      </p>

      <div class="space-y-8">
        {sections.map((s) => (
          <section class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
            <h2 class="mb-3 text-xl font-semibold text-slate-900 dark:text-white">{s.title}</h2>
            <p class="leading-relaxed text-slate-600 dark:text-slate-300">{s.body}</p>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
